# myfp 환경 변수 목록 (변수 이름과 설명만 둔다. 실제 값은 Vercel 환경 변수 또는 로컬 .env.local 에만 넣고 커밋하지 않는다)

# --- Auth.js (next-auth) ---
# 세션 토큰 서명용 임의 비밀 문자열 (충분히 긴 무작위 값)
AUTH_SECRET=
# 사이트 기준 주소 (예: https://myfp.example.com, 로컬은 http://localhost:3330)
AUTH_URL=
# (호스트 헤더 신뢰 여부는 코드에서 고정한다. 응답의 주소는 AUTH_URL 을 따른다.)
AUTH_TRUST_HOST=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Kakao OAuth ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# --- 데이터베이스 (PostgreSQL 연결 문자열; 서버 전용) ---
# 앱이 실행 중에 쓰는 연결. 스키마 myfp 만 쓸 수 있는 제한 역할(myfp_app)로 연결한다.
DATABASE_URL=
# 마이그레이션(npm run migrate) 전용 연결. 스키마 객체를 만들 수 있는 역할이어야 한다. 비워 두면 DATABASE_URL 을 쓴다.
# 앱 배포 환경(Vercel 등)에는 넣지 않고 마이그레이션을 실행하는 곳에서만 설정한다.
MIGRATE_DATABASE_URL=
# (선택) DB 서버 인증서 검증용 CA (PEM). 없으면 TLS 암호화만 하고 인증서 검증은 하지 않는다.
# 주의: DATABASE_URL·MIGRATE_DATABASE_URL 에 sslmode 파라미터를 두지 말 것 (연결 문자열의 sslmode 가 pg 의 ssl 설정을 덮어써 DATABASE_CA 가 무시된다).
DATABASE_CA=

# --- 관리자 부트스트랩 ---
# 처음부터 승인·관리자로 둘 이메일 목록 (쉼표 구분). 검증된 Google 이메일 또는 비상용 로그인에만 적용된다.
# 개인 데이터 적재 스크립트는 이 목록의 첫 이메일을 데이터 소유자로 쓴다.
ADMIN_EMAILS=
# 이메일·비밀번호(Credentials) 비상 로그인 허용 여부 (기본 꺼짐; 켜려면 1 또는 true)
AUTH_ENABLE_CREDENTIALS=
# 비상 관리자 비밀번호의 해시값 (node scripts/hash-password.mjs 로 만든다. 평문 비밀번호는 어디에도 두지 않는다)
ADMIN_BOOTSTRAP_PASSWORD_HASH=

# --- 기타 ---
# 실행 환경 표시 (예: production, preview, development)
APP_ENV=
